</head>
<body>
    <header class="header">
        <div class="container">
            <div class="header-content">
                <div class="logo">💰 SavvyFinance Admin</div>
                <div class="user-info">
                    <span>hello@savvyfinance.com</span>
                    <button class="btn" onclick="logout()" style="background: rgba(255,255,255,0.2); padding: 0.5rem 1rem;">Cerrar Sesión</button>
                </div>
            </div>
        </div>
    </header>

    <main class="main">
        <div class="container">
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-number" id="totalArticles">6</div>
                    <div class="stat-label">Total Artículos</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number" id="totalViews">8,660</div>
                    <div class="stat-label">Total Visualizaciones</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number" id="todayViews">156</div>
                    <div class="stat-label">Vistas Hoy</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number" id="subscribers">0</div>
                    <div class="stat-label">Suscriptores</div>
                </div>
            </div>

            <div class="dashboard-grid">
                <div class="card">
                    <h2>Crear Nuevo Artículo</h2>
                    <div id="articleMessage"></div>
                    <form id="articleForm">
                        <div class="form-group">
                            <label for="title">Título del Artículo</label>
                            <input type="text" id="title" name="title" required placeholder="Ej: Cómo Invertir en Bolsa en 2025">
                        </div>
                        
                        <div class="form-group">
                            <label for="category">Categoría</label>
                            <select id="category" name="category" required>
                                <option value="">Seleccionar categoría</option>
                                <option value="investing">Inversión</option>
                                <option value="retirement">Jubilación</option>
                                <option value="cryptocurrency">Criptomonedas</option>
                                <option value="budgeting">Presupuesto</option>
                                <option value="personal-finance">Finanzas Personales</option>
                                <option value="real-estate">Bienes Raíces</option>
                            </select>
                        </div>
                        
                        <div class="form-group">
                            <label for="excerpt">Resumen (Excerpt)</label>
                            <input type="text" id="excerpt" name="excerpt" required placeholder="Breve descripción del artículo...">
                        </div>
                        
                        <div class="form-group">
                            <label for="content">Contenido del Artículo</label>
                            <textarea id="content" name="content" required placeholder="Escribe aquí el contenido completo del artículo..."></textarea>
                        </div>
                        
                        <button type="submit" class="btn">Publicar Artículo</button>
                    </form>
                </div>

                <div class="card">
                    <h2>Artículos Publicados</h2>
                    <div class="article-list" id="articlesList">
                        <div class="article-item">
                            <div>
                                <div class="article-title">401(k) Rollover Guide 2025</div>
                                <div class="article-meta">Retirement • 1,250 vistas • 8 min lectura</div>
                            </div>
                        </div>
                        <div class="article-item">
                            <div>
                                <div class="article-title">S&P 500 Index Fund Investing Guide</div>
                                <div class="article-meta">Investing • 2,100 vistas • 12 min lectura</div>
                            </div>
                        </div>
                        <div class="article-item">
                            <div>
                                <div class="article-title">Bitcoin vs Ethereum 2025</div>
                                <div class="article-meta">Cryptocurrency • 1,850 vistas • 10 min lectura</div>
                            </div>
                        </div>
                        <div class="article-item">
                            <div>
                                <div class="article-title">Zero-Based Budgeting Guide</div>
                                <div class="article-meta">Budgeting • 1,420 vistas • 9 min lectura</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script>
        // Manejar envío de formulario de artículo
        document.getElementById('articleForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const messageDiv = document.getElementById('articleMessage');
            messageDiv.innerHTML = '';
            
            const formData = new FormData(e.target);
            const articleData = {
                title: formData.get('title'),
                category: formData.get('category'),
                excerpt: formData.get('excerpt'),
                content: formData.get('content'),
                author: 'SavvyFinance Team',
                status: 'published'
            };

            try {
                messageDiv.innerHTML = '<div class="success">✅ Artículo creado correctamente! Se ha publicado en el sitio web.</div>';
                
                e.target.reset();
                
                const currentTotal = parseInt(document.getElementById('totalArticles').textContent);
                document.getElementById('totalArticles').textContent = currentTotal + 1;
                
                const articlesList = document.getElementById('articlesList');
                const newArticle = document.createElement('div');
                newArticle.className = 'article-item';
                newArticle.innerHTML = `
                    <div>
                        <div class="article-title">${articleData.title}</div>
                        <div class="article-meta">${articleData.category} • 0 vistas • Recién publicado</div>
                    </div>
                `;
                articlesList.insertBefore(newArticle, articlesList.firstChild);
                
            } catch (error) {
                messageDiv.innerHTML = '<div class="error">❌ Error al crear el artículo. Inténtalo de nuevo.</div>';
            }
        });

        function logout() {
            alert('Sesión cerrada correctamente');
            window.location.href = '/';
        }
    </script>
</body>
</html>
